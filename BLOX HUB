<script>
const cards=[
  {type:'video',icon:'🎬',title:'Leopard Awakening Full Combo',meta:'2h ago · 1.2K views',excerpt:'Complete guide to mastering Leopard awakening combos in PVP. Covers timing, positioning, and counter-play.',tags:['Leopard','PVP','Mythical'],color:'#1565e8'},
  {type:'image',icon:'🖼',title:'Dragon Fruit Max Stats Screenshot',meta:'5h ago · 342 views',excerpt:'Full showcase of maxed Dragon fruit stats with optimal build configuration for sea beast farming.',tags:['Dragon','Stats'],color:'#e8192c'},
  {type:'guide',icon:'📖',title:'Beginner Guide: How to Get Your First Fruit',meta:'1d ago · 3.1K views',excerpt:'Step-by-step walkthrough for new players on how to find, eat, and use your first Devil Fruit effectively.',tags:['Beginner','Fruits','Tutorial'],color:'#00cfff'},
  {type:'video',icon:'🎬',title:'Buddha Raid Boss Strategy',meta:'2d ago · 892 views',excerpt:'How to solo raid bosses using Buddha transformation. Best accessories and stat distribution included.',tags:['Buddha','Raids','Strategy'],color:'#1565e8'},
  {type:'guide',icon:'📖',title:'Max Level Grinding Spots Guide',meta:'3d ago · 5.7K views',excerpt:'Optimal grinding routes for max level players across all three seas with XP efficiency breakdowns.',tags:['Grinding','XP','Max Level'],color:'#00cfff'},
  {type:'image',icon:'🖼',title:'Top 5 PVP Setups This Patch',meta:'4d ago · 1.8K views',excerpt:'Infographic showing the five strongest PVP loadouts in the current meta with damage numbers.',tags:['PVP','Meta','Build'],color:'#e8192c'},
];
const combos=[
  {name:'Leopard God Combo',fruit:'Leopard (Awakened)',difficulty:'hard',steps:['F Skill','Leopard Dash','C Skill','X Skill','Soru','Dragon Claw'],info:'Most feared combo in current meta. Deals 85%+ HP. Requires precise timing on the Soru step.',cat:'mythical'},
  {name:'Dragon Full Death Loop',fruit:'Dragon (Awakened)',difficulty:'hard',steps:['Roar','Z Skill','X Skill','C Skill','Obs Off','Dragon Talon'],info:'Infinite looping combo. Works best against enemies without Observation Haki.',cat:'mythical'},
  {name:'Buddha Pressure Combo',fruit:'Buddha (Awakened)',difficulty:'medium',steps:['Transform','Z Hit','Claw Shockwave','Ken Haki','X Hit','Ground Smash'],info:'Tanky brawler combo. Buddha reduces incoming damage while pressuring opponents.',cat:'legendary'},
  {name:'Dough Stun Lock',fruit:'Dough (Awakened)',difficulty:'hard',steps:['Donut Ring','Spatial Migration','X Skill','Slap','C Skill','Finisher'],info:'Keeps opponents stunned for extended duration. One of the highest damage combos if landed correctly.',cat:'mythical'},
  {name:'Dark Blade Sword User',fruit:'None + Dark Blade',difficulty:'easy',steps:['Shockwave Z','Triple Slash','Rush X','Impale'],info:'Pure sword user combo. Great for beginners. Dark Blade is obtainable early and scales well.',cat:'sword'},
  {name:'Magma Awakened Burst',fruit:'Magma (Awakened)',difficulty:'medium',steps:['Volcano Fist','Magma Floor','X Skill','Eruption'],info:'Excellent for zoning and environment control. The Magma Floor prevents opponent movement effectively.',cat:'legendary'},
  {name:'True Triple Dark Step',fruit:'None + Dark Step',difficulty:'easy',steps:['Kick Combo Z','Dark Barrage X','Triple Kick C','Obs Activation'],info:'Classic physical fighting style. No fruit needed. Reliable, fast, and great for competitive play.',cat:'physical'},
];
const tiers=[
  {t:'s',label:'S',items:[{i:'🐆',n:'Leopard'},{i:'🐉',n:'Dragon'},{i:'🕊',n:'Dough'},{i:'☠️',n:'Venom'}]},
  {t:'a',label:'A',items:[{i:'🌋',n:'Magma'},{i:'🌸',n:'Sakura'},{i:'⚡',n:'Lightning'},{i:'🔮',n:'Control'},{i:'🌊',n:'Quake'}]},
  {t:'b',label:'B',items:[{i:'☯️',n:'Buddha'},{i:'❄️',n:'Ice'},{i:'🔥',n:'Flame'},{i:'💨',n:'Smoke'},{i:'💎',n:'Diamond'},{i:'🌀',n:'Gravity'}]},
  {t:'c',label:'C',items:[{i:'🌑',n:'Dark'},{i:'🍄',n:'Rumble'},{i:'⚙️',n:'Barrier'},{i:'💧',n:'Sand'},{i:'🪨',n:'Spike'}]},
  {t:'d',label:'D',items:[{i:'🎈',n:'Spin'},{i:'💣',n:'Bomb'},{i:'🐚',n:'Chop'},{i:'🪱',n:'Spring'}]},
];
const comments=[
  {user:'ProGamerX',time:'2h ago',text:'Bro the Leopard combo is INSANE right now. No cap this site helped me go from trash to top 10 on the server.',likes:47},
  {user:'FruitHunter99',time:'5h ago',text:'The fruit scaling tier list is super accurate. Dragon has been S tier since the last patch dropped.',likes:31},
  {user:'NoobSlayer22',time:'8h ago',text:'Finally a proper guide that explains the awakening system. I spent 3 days trying to figure it out on my own lol',likes:28},
  {user:'SeaKing_Blox',time:'1d ago',text:'Can you do a guide on how to counter Buddha users? They are everywhere in my server and I cannot touch them',likes:19},
  {user:'BloxLegend',time:'2d ago',text:'These combos actually work in practice unlike some other guides. The timing tips make a huge difference.',likes:52},
  {user:'FruitMaster77',time:'3d ago',text:'Just got Dough fruit from the dealer and this guide helped me maximize it. W site ngl.',likes:35},
  {user:'PVPking',time:'1d ago',text:'Dark blade sword combo is underrated. Been using it since day 1 and it still catches everyone off guard.',likes:22},
];

function makeCard(c){
  return `<div class="content-card"><div class="card-thumb" style="background:linear-gradient(135deg,var(--bg-card2),${c.color}33)"><span style="font-size:3.5rem;position:relative;z-index:1">${c.icon}</span><span class="card-type-badge badge-${c.type}">${c.type.toUpperCase()}</span></div><div class="card-body"><div class="card-title">${c.title}</div><div class="card-meta"><span>👁 ${c.meta}</span></div><div class="card-excerpt">${c.excerpt}</div><div class="card-tags">${c.tags.map(t=>`<span class="card-tag">${t}</span>`).join('')}</div></div></div>`;
}

function makeComment(c){
  return `<div class="comment-item"><div class="comment-avatar" style="font-size:0.85rem">${c.user[0]}</div><div style="flex:1"><div class="comment-meta"><span class="comment-user">${c.user}</span><span class="comment-time">${c.time}</span></div><div class="comment-text">${c.text}</div><div class="comment-actions"><button class="comment-action-btn" onclick="toggleLike(this,${c.likes})">&#10084; ${c.likes}</button><button class="comment-action-btn" onclick="showToast('Reply feature coming soon!','info')">&#x1F4AC; Reply</button></div></div></div>`;
}

function makeCommentSection(containerId,countId,slice){
  const el=document.getElementById(containerId);
  if(!el)return;
  el.innerHTML=`<div class="comment-form"><div class="comment-avatar">U</div><div class="comment-input-wrap"><textarea class="comment-input" placeholder="Share your thoughts..." id="inp-${containerId}"></textarea><div class="comment-submit"><button class="btn-submit" onclick="postComment('${containerId}','${countId}')">&#x1F4AC; Post Comment</button></div></div></div><div class="comments-list" id="list-${containerId}">${comments.slice(...slice).map(makeComment).join('')}</div>`;
}

function renderCombos(filter='all',search=''){
  const list=document.getElementById('combos-list');
  const f=combos.filter(c=>(filter==='all'||c.cat===filter)&&(search===''||c.name.toLowerCase().includes(search)||c.fruit.toLowerCase().includes(search)));
  list.innerHTML=f.map(c=>`<div class="combo-card"><div class="combo-title">&#x2694; ${c.name}<span class="difficulty-badge diff-${c.difficulty}">${c.difficulty}</span></div><div style="font-size:0.78rem;color:var(--text-secondary);margin-bottom:0.75rem;font-family:'Rajdhani',sans-serif;letter-spacing:1px;text-transform:uppercase">&#x1F34E; ${c.fruit}</div><div class="combo-steps">${c.steps.map((s,i)=>`<span class="combo-step">${s}</span>${i<c.steps.length-1?'<span class="combo-arrow">&#x2192;</span>':''}`).join('')}</div><div class="combo-info">${c.info}</div></div>`).join('');
}

function renderTiers(){
  document.getElementById('tier-list').innerHTML=tiers.map(t=>`<div class="tier-row"><div class="tier-label tier-${t.t}">${t.label}</div><div class="tier-items">${t.items.map(i=>`<div class="tier-item"><span>${i.i}</span>${i.n}</div>`).join('')}</div></div>`).join('');
}

window.addEventListener('DOMContentLoaded',()=>{
  document.getElementById('home-grid').innerHTML=cards.map(makeCard).join('');
  document.getElementById('media-grid').innerHTML=cards.filter(c=>c.type!=='guide').map(makeCard).join('');
  document.getElementById('guides-grid').innerHTML=cards.filter(c=>c.type==='guide').map(makeCard).join('');
  renderCombos();
  renderTiers();
  makeCommentSection('home-comments','home-cc',[0,3]);
  makeCommentSection('combos-comments','combos-cc',[2,5]);
  makeCommentSection('scaling-comments','scaling-cc',[1,4]);
  makeCommentSection('media-comments','media-cc',[3,6]);
  makeCommentSection('guides-comments','guides-cc',[4,7]);
});

let curFilter='all';
function switchTab(id){
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('panel-'+id).classList.add('active');
  document.getElementById('tab-'+id).classList.add('active');
}
function showTab(id,el){
  switchTab(id);
  document.querySelectorAll('.nav-links a').forEach(a=>a.classList.remove('active'));
  if(el)el.classList.add('active');
}
function filterCombos(v){renderCombos(curFilter,v.toLowerCase());}
function setFilter(f,el){curFilter=f;document.querySelectorAll('.filter-tag').forEach(t=>t.classList.remove('active'));el.classList.add('active');renderCombos(f);}
function openUploadModal(tab){document.getElementById('upload-modal').classList.add('open');if(tab)switchModalTab(tab,null);}
function closeModal(){document.getElementById('upload-modal').classList.remove('open');}
function switchModalTab(tab,btn){['video','image','guide','combo'].forEach(t=>{const e=document.getElementById('modal-'+t+'-form');if(e)e.style.display=t===tab?'block':'none';});document.querySelectorAll('.modal-tab-btn').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');}
function submitContent(){closeModal();showToast('Content published successfully!','success');}
function postComment(cid,ccid){const inp=document.getElementById('inp-'+cid);const t=inp.value.trim();if(!t){showToast('Please write something first!','error');return;}const list=document.getElementById('list-'+cid);list.insertAdjacentHTML('afterbegin',makeComment({user:'You',time:'Just now',text:t,likes:0}));inp.value='';const el=document.getElementById(ccid);if(el)el.textContent=parseInt(el.textContent)+1;showToast('Comment posted!','success');}
function toggleLike(btn,start){const on=btn.classList.toggle('liked');btn.innerHTML='&#10084; '+(start+(on?1:0));}
let toastT;
function showToast(msg,type){const t=document.getElementById('toast');document.getElementById('toast-msg').textContent=msg;t.className='toast show'+(type==='error'?' error':'');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),3000);}
document.getElementById('upload-modal').addEventListener('click',function(e){if(e.target===this)closeModal();});
</script>
</body>
</html>

